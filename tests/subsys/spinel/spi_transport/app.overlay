/ {
	fake_spis: fake_spis {
		compatible = "opener,test-fake-spis";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;

		spinel@0 {
			compatible = "opener,spinel-spi";
			reg = <0>;
			spi-max-frequency = <8000000>;
			irq-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
			busy-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		};
	};
};
