&i2c2 {
    status = "okay";

    // STMicroelectronics LSM6DSL 6-axis accelerometer and gyrometer accessed throug i2c bus
    lsm6dsl: lsm6dsl@6a {
        compatible = "st,lsm6dsl";
        status = "okay";
        reg = <0x6A>;
        irq-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
        #address-cells = <1>;
        #size-cells = <0>;

        // STMicroelectronics LIS2MDL magnetometer integrated with LSM6DSL
        lis2mdl: lis2mdl@40 {
            compatible = "st,lis2mdl";
            status = "okay";
            reg = <0x40>;
        };
    };

    sht40: sht4x@44 {
        compatible = "sensirion,sht4x";
        status = "okay";
        repeatability = <2>;
        reg = <0x44>;
        friendly-name = "sht40";
    };

    //PMIC npm1300
    npm1300: npm1300@6b {
        compatible = "nordic,npm1300";
        status = "okay";
        reg = <0x6b>;

        npm1300_charger: npm1300-charger {
            compatible = "nordic,npm1300-charger";
            status = "okay";
            charging-enable;
            term-microvolt = <4200000>; //uV => 4.2V
            current-microamp = <500000>; // uA => 500mA
            dischg-limit-microamp = <1000000>; // uA => 200mA
            vbus-limit-microamp = <500000>; // uA => 500mA
            thermistor-ohms = <0>; // Ohms => 0Ohms
            thermistor-beta = <0>;
            term-current-percent = <10>;
        };

        npm1300_led: npm1300-led {
            compatible = "nordic,npm1300-led";
            status = "okay";
            nordic,led0-mode = "host";
            nordic,led1-mode = "charging";
            nordic,led2-mode = "error";

        };
    };
};
