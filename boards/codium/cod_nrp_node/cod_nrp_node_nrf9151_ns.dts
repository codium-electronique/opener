/dts-v1/;

#include <arm/nordic/nrf9151_ns_laca.dtsi>
#include "cod_nrp_node_nrf9151_common.dtsi"

/ {
    chosen {
        zephyr,flash = &flash0;
        zephyr,sram = &sram0_ns_app;
        zephyr,code-partition = &slot0_ns_partition;
        //zephyr,bt-hci=&bt_hci_uart;
        //codlibz,bt-reset = &nrf54l15_reset;
        //codlibz,bt-crash = &nrf54l15_crash;
        //codlibz,c2p-prov-uart = &uart0;
    };

    buttons {
		compatible = "gpio-keys";
		button1: button1 {
			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
			label = "User Button";
		};
	};

    /* FIXME: Enable and set proper pins for REV B */
    /*nrf54l15_reset: nrf54l15-reset {
        compatible = "codium,bt-reset";
        status = "okay";

        reset-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
    };

    nrf54l15_crash: nrf54l15-crash {
        compatible = "codium,bt-crash";
        status = "okay";

        crash-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
    };*/
};

&gpio0 {
    // Use sense mechanism for GPIO edge detection on BLE LPUART REQ / RDY and inputs
    // nRF54L15 crash
    sense-edge-mask = <((1 << 0) | (1 << 4))>;
};

&gpiote {
    // Interrupts higher priority to lower radio latency
    interrupts = <49 NRF_DEFAULT_IRQ_PRIORITY>;
};

